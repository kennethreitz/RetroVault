+void DSUController::start_rumble()
+{
+	if (!is_connected() || m_settings.rumble <= 0)
+		return;
+
+	const auto intensity = static_cast<uint8_t>(std::clamp(m_settings.rumble, 0.0f, 1.0f) * 255.0f);
+	m_provider->set_rumble(m_index, intensity, intensity);
+}
+
+void DSUController::stop_rumble()
+{
+	if (!is_connected())
+		return;
+
+	m_provider->set_rumble(m_index, 0, 0);
+}
